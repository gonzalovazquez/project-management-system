<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ONLY for unsigned (ad-hoc) test builds, made when no Developer ID credentials are present.
  An ad-hoc signature has no Team ID, so under the hardened runtime the app could not load its own
  Electron framework without disable-library-validation. A Developer ID build signs every part
  with the same team and uses build/entitlements.mac.plist, which does not grant this.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
