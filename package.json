{
  "name": "pm-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop hub that connects a product manager's artifacts, CRM and PDR GitHub repos around the product they're managing",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "node scripts/ensure-electron.mjs",
    "start": "electron-vite preview",
    "smoke": "bash scripts/smoke.sh",
    "seed": "tsx scripts/seed.ts",
    "package": "npm run build && node scripts/package.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "icon": "node scripts/make-icon.mjs",
    "licenses": "node scripts/licenses.mjs > docs/security/dependencies.md"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0"
  },
  "main": "./out/main/index.js",
  "author": "Gonzalo Vazquez",
  "build": {
    "appId": "com.gonzalovazquez.pm-workbench",
    "productName": "PM Workbench",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "target": "dir"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "publish": null,
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/electron-LICENSE"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      },
      {
        "from": "docs/security/dependencies.md",
        "to": "licenses/dependencies.md"
      }
    ]
  }
}
